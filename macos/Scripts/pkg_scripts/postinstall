#!/bin/sh

STAGE_DIR="/Library/Application Support/ChimeInstaller"
STAGE_APP="$STAGE_DIR/Chime.app"
LEGACY_SYS_APP="/Library/Input Methods/Chime.app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
LOG_FILE="/tmp/chime-install.log"

{
    echo "=== Chime postinstall v0.15.4 started at $(date) ==="

    CONSOLE_USER="$(/usr/bin/stat -f "%Su" /dev/console 2>/dev/null || true)"
    CONSOLE_UID=""
    USER_HOME=""
    if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ] && [ "$CONSOLE_USER" != "_mbsetupuser" ]; then
        CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null || true)"
        USER_HOME="$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
    fi
    echo "Detected console user='$CONSOLE_USER' uid='$CONSOLE_UID' home='$USER_HOME'"

    # Install into the user's writable ~/Library/Input Methods/Chime.app whenever an interactive
    # user home is present, AND cleanly remove any legacy root-owned /Library/Input Methods/Chime.app.
    # This gives every user silent, zero-password, zero-Touch-ID in-app hot updates forever after!
    TARGET_APP="$LEGACY_SYS_APP"
    IS_USER_SPACE=0
    if [ -n "$CONSOLE_USER" ] && [ -n "$USER_HOME" ] && [ -d "$USER_HOME" ]; then
        TARGET_DIR="$USER_HOME/Library/Input Methods"
        TARGET_APP="$TARGET_DIR/Chime.app"
        IS_USER_SPACE=1
    fi
    echo "Target install path='$TARGET_APP' (user_space=$IS_USER_SPACE)"

    if [ ! -d "$STAGE_APP" ]; then
        echo "ERROR: staged bundle $STAGE_APP not found!"
        exit 0
    fi

    # Detect whether Chime is ALREADY enabled for the active console user.
    ALREADY_ENABLED=0
    if [ -n "$USER_HOME" ] && /usr/bin/plutil -p "$USER_HOME/Library/Preferences/com.apple.HIToolbox.plist" 2>/dev/null | /usr/bin/grep -q "app.tyrchen.inputmethod.Chime"; then
        ALREADY_ENABLED=1
    fi
    echo "ALREADY_ENABLED=$ALREADY_ENABLED"

    # Atomically swap the new bundle onto disk FIRST (before stopping the old Chime process)
    # so macOS imklaunchagent can never race us and respawn the old binary!
    if [ "$IS_USER_SPACE" -eq 1 ]; then
        mkdir -p "$USER_HOME/Library/Input Methods" 2>&1 || true
        chown "$CONSOLE_USER:staff" "$USER_HOME/Library/Input Methods" 2>&1 || true

        OLD_BAK="$TARGET_APP.old.$$"
        rm -rf "$OLD_BAK" 2>&1 || true
        if [ -d "$TARGET_APP" ]; then
            /bin/mv "$TARGET_APP" "$OLD_BAK" 2>&1 || true
        fi
        /bin/mv "$STAGE_APP" "$TARGET_APP" 2>&1 || /usr/bin/ditto "$STAGE_APP" "$TARGET_APP" 2>&1 || true
        rm -rf "$OLD_BAK" 2>&1 || true
        chown -R "$CONSOLE_USER:staff" "$TARGET_APP" 2>&1 || true
        chmod -R u+rwX,go+rX "$TARGET_APP" 2>&1 || true
        chmod +x "$TARGET_APP/Contents/MacOS/Chime" 2>&1 || true
        xattr -dr com.apple.quarantine "$TARGET_APP" 2>&1 || true

        # Remove legacy root-owned system copy so macOS never sees duplicate Chime bundles
        if [ -d "$LEGACY_SYS_APP" ]; then
            echo "Migrated to user-writable ~/Library/Input Methods/Chime.app; removing legacy $LEGACY_SYS_APP"
            rm -rf "$LEGACY_SYS_APP" 2>&1 || true
            /usr/bin/touch "/Library/Input Methods" 2>&1 || true
        fi
        /usr/bin/touch "$USER_HOME/Library/Input Methods" 2>&1 || true
    else
        mkdir -p "/Library/Input Methods" 2>&1 || true
        OLD_BAK="$LEGACY_SYS_APP.old.$$"
        rm -rf "$OLD_BAK" 2>&1 || true
        if [ -d "$LEGACY_SYS_APP" ]; then
            /bin/mv "$LEGACY_SYS_APP" "$OLD_BAK" 2>&1 || true
        fi
        /bin/mv "$STAGE_APP" "$LEGACY_SYS_APP" 2>&1 || /usr/bin/ditto "$STAGE_APP" "$LEGACY_SYS_APP" 2>&1 || true
        rm -rf "$OLD_BAK" 2>&1 || true
        chown -R root:wheel "$LEGACY_SYS_APP" 2>&1 || true
        chmod -R u+rwX,go+rX "$LEGACY_SYS_APP" 2>&1 || true
        chmod +x "$LEGACY_SYS_APP/Contents/MacOS/Chime" 2>&1 || true
        xattr -dr com.apple.quarantine "$LEGACY_SYS_APP" 2>&1 || true
        /usr/bin/touch "/Library/Input Methods" 2>&1 || true
    fi
    rm -rf "$STAGE_DIR" 2>&1 || true

    # Now stop the old running Chime process so launch/respawn strictly loads the new bundle
    pkill -x Chime 2>&1 || true

    APP_BIN="$TARGET_APP/Contents/MacOS/Chime"
    "$LSREGISTER" -f -R -trusted "$TARGET_APP" 2>&1 || true

    if [ "$ALREADY_ENABLED" -eq 1 ]; then
        echo "Smooth upgrade path: gently restarting Chime without disturbing TIS registration"
        if [ -n "$CONSOLE_UID" ] && [ -x "$APP_BIN" ]; then
            /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" "$LSREGISTER" -f -R -trusted "$TARGET_APP" 2>&1 || true
            sleep 0.3
            /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/open -n -g -a "$TARGET_APP" 2>&1 || true
        fi
    else
        echo "Fresh install path: registering Chime with HIToolbox and opening Input Sources"

        if [ -n "$CONSOLE_UID" ] && /usr/bin/pgrep -u "$CONSOLE_UID" -x "System Settings" >/dev/null 2>&1; then
            /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/osascript -e 'tell application id "com.apple.systempreferences" to quit' 2>&1 || true
            for _ in 1 2 3 4 5; do
                /usr/bin/pgrep -u "$CONSOLE_UID" -x "System Settings" >/dev/null 2>&1 || break
                sleep 0.2
            done
        fi

        killall KeyboardSettings "Keyboard-Settings.extension" 2>&1 || true

        rm -f /System/Library/Caches/com.apple.IntlDataCache.le* \
              /Library/Caches/com.apple.IntlDataCache.le* \
              /private/var/folders/*/*/C/com.apple.IntlDataCache.le* \
              /private/var/folders/*/*/C/*/com.apple.IntlDataCache.le* 2>&1 || true

        if [ -x "$APP_BIN" ]; then
            "$APP_BIN" --register "$TARGET_APP" 2>&1 || true
            chmod 644 /System/Library/Caches/com.apple.IntlDataCache.le* 2>/dev/null || true
        fi

        killall imklaunchagent TextInputMenuAgent TextInputSwitcher CursorUIViewService 2>&1 || true
        sleep 1

        if [ -n "$CONSOLE_UID" ] && [ -x "$APP_BIN" ]; then
            /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" "$LSREGISTER" -f -R -trusted "$TARGET_APP" 2>&1 || true

            USER_CACHE_DIR="$(/bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/getconf DARWIN_USER_CACHE_DIR 2>/dev/null || true)"
            if [ -n "$USER_CACHE_DIR" ] && [ -d "$USER_CACHE_DIR" ]; then
                rm -f "$USER_CACHE_DIR"/com.apple.IntlDataCache.le* \
                      "$USER_CACHE_DIR"/com.apple.Keyboard-Settings.extension/com.apple.IntlDataCache.le* 2>&1 || true
            fi

            /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/open -n -g -a "$TARGET_APP" --args --activate-on-install 2>&1 || true

            for _ in 1 2 3 4 5 6; do
                if /usr/bin/pgrep -u "$CONSOLE_UID" -x Chime >/dev/null 2>&1; then
                    echo "Chime IMKServer daemon is running under uid $CONSOLE_UID"
                    break
                fi
                sleep 0.4
            done
            sleep 1.0

            /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/open "x-apple.systempreferences:com.apple.Keyboard-Settings.extension?InputSources" 2>&1 || true
        fi
    fi

    echo "=== Chime postinstall v0.15.4 finished at $(date) ==="
} >> "$LOG_FILE" 2>&1 || true

chmod 644 "$LOG_FILE" 2>/dev/null || true
exit 0
